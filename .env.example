# ─────────────────────────────────────────────────────────────
# Scholiva — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Scholiva"

# ── Database (PostgreSQL) ──
# Local:    postgresql://user:pass@localhost:5432/scholiva
# Supabase/Neon/Railway: use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholiva?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scholiva?schema=public"

# ── NextAuth ──
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# OAuth providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (Resend) ──
RESEND_API_KEY=""
EMAIL_FROM="Scholiva <noreply@scholiva.com>"

# ── Payments: Stripe (international cards, Apple Pay, Google Pay) ──
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Payments: Paystack (Nigeria / Africa) ──
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ── Payments: Flutterwave (Pan-African) ──
FLUTTERWAVE_SECRET_KEY=""
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_ENCRYPTION_KEY=""

# ── Storage: Supabase Storage (order file uploads) ──
# SUPABASE_URL is your project URL (https://<ref>.supabase.co).
# SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API → service_role (secret, server-only).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Storage: Cloudinary (images, avatars, small assets) ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Storage: AWS S3 (large project files up to 500MB, via presigned URLs) ──
AWS_REGION="eu-west-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="scholiva-uploads"

# ── WhatsApp click-to-chat ──
NEXT_PUBLIC_WHATSAPP_NUMBER="2348000000000"

# ── Multi-currency (base + exchange rate API, optional) ──
NEXT_PUBLIC_DEFAULT_CURRENCY="NGN"
EXCHANGE_RATE_API_KEY=""
